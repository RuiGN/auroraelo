{
  "name": "aurora-elo-posalta",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "EXPO_NO_DOTENV=1 expo start",
    "start:preview": "EXPO_NO_DOTENV=1 EXPO_PUBLIC_APP_MODE=preview expo start",
    "android": "EXPO_NO_DOTENV=1 expo start --android",
    "ios": "EXPO_NO_DOTENV=1 expo start --ios",
    "web": "EXPO_NO_DOTENV=1 expo start --web",
    "web:preview": "EXPO_NO_DOTENV=1 EXPO_PUBLIC_APP_MODE=preview expo start --web",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check App.tsx index.js '*.config.js' tsconfig.json app.json 'src/**/*.{ts,tsx}' 'tests/*.{ts,tsx,js}'",
    "format": "prettier --write App.tsx index.js '*.config.js' tsconfig.json app.json 'src/**/*.{ts,tsx}' 'tests/*.{ts,tsx,js}'",
    "test": "TZ=America/Sao_Paulo jest --runInBand",
    "export": "EXPO_NO_DOTENV=1 expo export --platform all",
    "export:preview": "EXPO_NO_DOTENV=1 EXPO_PUBLIC_APP_MODE=preview expo export --platform web --output-dir dist-preview",
    "tokens": "node scripts/sync-tokens.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/manrope": "^0.4.2",
    "@expo/metro-runtime": "~4.0.1",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-navigation/bottom-tabs": "^7.20.0",
    "@react-navigation/native": "^7.5.0",
    "@react-navigation/native-stack": "^7.20.0",
    "expo": "~52.0.0",
    "expo-asset": "~11.0.5",
    "expo-constants": "~17.0.8",
    "expo-font": "~13.0.4",
    "expo-secure-store": "~14.0.1",
    "expo-status-bar": "~2.0.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.9",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-svg": "15.8.0",
    "react-native-web": "~0.19.13"
  },
  "devDependencies": {
    "@testing-library/react-native": "12.9.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~18.3.12",
    "jest": "^29.7.0",
    "jest-expo": "~52.0.0",
    "prettier": "3.6.2",
    "react-test-renderer": "18.3.1",
    "typescript": "~5.3.3"
  }
}
