  "main": "index.js",
  "scripts": {
    "start": "EXPO_NO_DOTENV=1 expo start",
    "android": "EXPO_NO_DOTENV=1 expo start --android",
    "ios": "EXPO_NO_DOTENV=1 expo start --ios",
    "web": "EXPO_NO_DOTENV=1 expo start --web",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check App.tsx index.js '*.config.js' tsconfig.json app.json 'src/**/*.{ts,tsx}' 'tests/*.{ts,tsx,js}' '../shared/*.ts'",
