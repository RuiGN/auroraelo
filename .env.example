# Local development example only. Configure production values explicitly.
# Django Settings
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=replace-with-a-long-random-value-at-least-50-chars
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_TIME_ZONE=America/Sao_Paulo
DJANGO_ALLOW_DEMO_SEED=false

# Security & Compliance Keys
AUDIT_INTEGRITY_KEY=replace-with-at-least-32-character-independent-key
MFA_ENCRYPTION_KEY=replace-with-an-independent-kms-managed-key
MFA_ENFORCEMENT_ENABLED=true
MFA_RATE_LIMIT_ATTEMPTS=5
MFA_RATE_LIMIT_WINDOW_SECONDS=300
SENSITIVE_REAUTH_RATE_LIMIT_ATTEMPTS=5
SENSITIVE_REAUTH_RATE_LIMIT_WINDOW_SECONDS=300
ACCOUNT_SESSION_IDLE_SECONDS=1800
ACCOUNT_SESSION_ABSOLUTE_SECONDS=43200
AUDIT_RETENTION_DAYS=2190
PRIVACY_REQUEST_DUE_DAYS=15
PRIVACY_REAUTH_MAX_AGE_SECONDS=600
PRIVACY_EXPORT_TTL_SECONDS=900

# PostgreSQL Configuration
DB_NAME=mindcare
DB_USER=mindcare
DB_PASSWORD=replace-with-a-secure-database-password
DB_HOST=127.0.0.1
DB_PORT=55439
DB_SSLMODE=disable
# DB_SSLROOTCERT=/run/secrets/postgresql-ca.pem  # Only if DB_SSLMODE=verify-full

# RabbitMQ / Celery
# The *_URLENCODED values are used only in the AMQP URL; keep the raw values above
# for RabbitMQ and URL-encode them separately (quote(..., safe="")).
RABBITMQ_DEFAULT_USER=replace-with-rabbitmq-user
RABBITMQ_DEFAULT_PASS=replace-with-rabbitmq-password
RABBITMQ_DEFAULT_USER_URLENCODED=replace-with-url-encoded-rabbitmq-user
RABBITMQ_DEFAULT_PASS_URLENCODED=replace-with-url-encoded-rabbitmq-password

# Redis Cache
CACHE_URL=redis://127.0.0.1:56389/1
CACHE_LOCATION=mindcare

# Email / Notifications
MAILER_BACKEND=django.core.mail.backends.smtp.EmailBackend
MAILER_HOST=localhost
MAILER_PORT=1025
MAILER_USERNAME=
MAILER_PASSWORD=
MAILER_USE_TLS=false
DEFAULT_FROM_EMAIL=no-reply@mindcare.example.test

# Malware Scanner (Optional)
PRIVATE_UPLOAD_MALWARE_SCAN_COMMAND=

# Docker Compose Port
WEB_PORT=8149

# Stripe Billing (Master Panel)
STRIPE_SECRET_KEY=sk_test_replace-with-your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=pk_test_replace-with-your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=whsec_replace-with-your-stripe-webhook-signing-secret
STRIPE_PRICE_STARTER=price_replace-with-starter-price-id
STRIPE_PRICE_PROFESSIONAL=price_replace-with-professional-price-id
STRIPE_PRICE_ENTERPRISE=price_replace-with-enterprise-price-id

# Master Panel Superuser (mandatory; never use a shared default)
MASTER_USER_EMAIL=replace-with-master-email
MASTER_USER_PASSWORD=replace-with-a-strong-master-password
